+/*
+ * Flush the log now and wait (at most 2 s) until everything printed so far
+ * is on the disk: for drivers about to do something that may reset the
+ * phone without a panic. Thread context only; returns at once otherwise.
+ */
+void sweet_log_sync(void);
+
+void
+sweet_log_sync(void)
+{
+	uint64_t want = os_atomic_load(&sweet_log_total, relaxed);
+
+	if (!sweet_log_running || get_preemption_level() != 0) {
+		return;
+	}
+	wakeup(&sweet_log_chan);
+	for (int i = 0; i < 20 && os_atomic_load(&sweet_log_flushed, acquire) < want; i++) {
+		(void)tsleep(&sweet_log_flushed, PZERO, "sweetlogsync", MAX(hz / 10, 1));
 	}
 }
 
