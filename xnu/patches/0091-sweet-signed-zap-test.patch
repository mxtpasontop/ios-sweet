+static bool scm_zap_ready, scm_zap_attempted;
+#define ZAP_ALLOC_SIZE 0x100000u
+#define ZAP_LOGICAL_SIZE 0x1000u
+
+/* ELF32 little endian, byte accesses also accept an unaligned ADT property. */
+static uint32_t
+zap_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static uint16_t
+zap_u16(const uint8_t *p)
+{
+	return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+}
+
+/* Narrow a615_zap format: header + hash metadata, one relocatable code blob. */
+static bool
+zap_valid(const uint8_t *mdt, unsigned size, const uint8_t *code, unsigned code_size)
+{
+	if (!mdt || !code || size <= 148 || size > 8192 || !code_size || code_size > 4096 ||
+	    zap_u32(mdt) != 0x464c457f || mdt[4] != 1 || mdt[5] != 1 || mdt[6] != 1 ||
+	    zap_u16(mdt + 16) != 2 || zap_u16(mdt + 18) != 164 || zap_u32(mdt + 20) != 1 ||
+	    zap_u32(mdt + 24) != 0x5000 || zap_u32(mdt + 28) != 52 ||
+	    zap_u16(mdt + 40) != 52 || zap_u16(mdt + 42) != 32 || zap_u16(mdt + 44) != 3) {
+		return false;
+	}
+	const uint8_t *header = mdt + 52, *hash = header + 32, *load = hash + 32;
+	return zap_u32(header) == 0 && zap_u32(header + 4) == 0 &&
+	       zap_u32(header + 16) == 148 && zap_u32(header + 20) == 0 &&
+	       zap_u32(hash) == 0 && zap_u32(hash + 4) == 0x1000 &&
+	       zap_u32(hash + 12) == 0x6000 && zap_u32(hash + 16) == size - 148 &&
+	       zap_u32(hash + 20) == 0x2000 && zap_u32(hash + 24) == 0x02200000 &&
+	       zap_u32(load) == 1 && zap_u32(load + 4) == 0x3000 &&
+	       zap_u32(load + 12) == 0x5000 && zap_u32(load + 16) == code_size &&
+	       zap_u32(load + 20) == code_size && zap_u32(load + 24) == 0x08000007 &&
+	       zap_u32(load + 28) == ZAP_ALLOC_SIZE;
+}
+
+enum zap_result { ZAP_OK, ZAP_ERROR, ZAP_UNFINISHED };
+static enum zap_result
+zap_call(const char *name, uint32_t cmd, uint32_t arginfo, uint64_t arg1, uint64_t arg2)
+{
+	struct scm_regs r;
+	const struct scm_regs initial = {
+		{ SCM_64 | SCM_SIP | 0x0200u | cmd, arginfo, SCM_PAS_GPU, arg1, arg2, 0, 0 }
+	};
+	printf("SWEET SCM: zap %s fn=%#llx info=%#x args=%#llx/%#llx/%#llx\n",
+	    name, initial.a[0], arginfo, initial.a[2], arg1, arg2);
+	sweet_log_sync();
+	__asm__ volatile("dsb sy" ::: "memory");
+	bool done = scm_invoke(&initial, false, &r);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET SCM: zap %s completed=%u status=%d result=%d\n",
+	    name, done, (int32_t)r.a[0], (int32_t)r.a[1]);
+	sweet_log_sync();
+	if (!done) {
+		return ZAP_UNFINISHED;
+	}
+	return (int32_t)r.a[0] == 0 && (int32_t)r.a[1] == 0 ? ZAP_OK : ZAP_ERROR;
+}
+
+/* Return true only if PAS never started or a completed shutdown quiesced it. */
+bool
+sweet_scm_gpu_zap_test(void)
+{
+	if (!scm_zap_ready || scm_zap_attempted) {
+		printf("SWEET SCM: zap test not ready or already attempted\n");
+		return !scm_zap_attempted;
+	}
+	scm_zap_attempted = true;
+	DTEntry node;
+	const uint8_t *mdt = NULL, *code = NULL;
+	unsigned mdt_size = 0, code_size = 0;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "zap-metadata", (const void **)&mdt, &mdt_size) != kSuccess ||
+	    SecureDTGetProperty(node, "zap-code", (const void **)&code, &code_size) != kSuccess ||
+	    !zap_valid(mdt, mdt_size, code, code_size)) {
+		printf("SWEET SCM: missing or unsupported a615_zap metadata/code\n");
+		return true;
+	}
+	/* One aligned, owned MiB for the protected image; metadata in a separate page. */
+	vm_offset_t kva;
+	const vm_size_t bytes = ZAP_ALLOC_SIZE + PAGE_SIZE;
+	if (kmem_alloc_contig(kernel_map, &kva, bytes, ZAP_ALLOC_SIZE - 1, 0, (ZAP_ALLOC_SIZE >> PAGE_SHIFT) - 1,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET SCM: zap contiguous allocation failed\n");
+		return true;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	uint64_t pa = ptoa_64(pn);
+	if (!pn || (pa & (ZAP_ALLOC_SIZE - 1))) {
+		printf("SWEET SCM: zap invalid allocation PA/alignment\n");
+		return true;
+	}
+	for (unsigned i = 0; i < bytes / PAGE_SIZE; ++i) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(kva + i * PAGE_SIZE)) != pn + i) {
+			printf("SWEET SCM: zap allocation not physically contiguous\n");
+			return true;
+		}
+	}
+	for (unsigned i = 0; i < bytes / PAGE_SIZE; ++i) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	flush_dcache64((addr64_t)pa, bytes, TRUE);
+	memcpy((void *)(kva + ZAP_ALLOC_SIZE), mdt, mdt_size);
+	printf("SWEET SCM: zap owned image=%#llx allocation=%#x logical=%#x metadata=%#llx/%u code=%u\n",
+	    pa, ZAP_ALLOC_SIZE, ZAP_LOGICAL_SIZE, pa + ZAP_ALLOC_SIZE, mdt_size, code_size);
+	/* SCM_ARGS(2, VAL, RW) = 2 | (2 << 6) = 0x82. Monitor verifies signatures. */
+	enum zap_result result = zap_call("INIT_IMAGE", 1, 0x82, pa + ZAP_ALLOC_SIZE, 0);
+	if (result != ZAP_OK) {
+		return result == ZAP_ERROR;
+	}
+	result = zap_call("MEM_SETUP", 2, 3, pa, ZAP_LOGICAL_SIZE);
+	if (result == ZAP_OK) {
+		memcpy((void *)kva, code, code_size);
+		result = zap_call("AUTH_AND_RESET", 5, 1, 0, 0);
+		if (result == ZAP_OK) {
+			printf("SWEET SCM: signed zap authenticated and started\n");
+			sweet_log_sync();
+		}
+	}
+	/* An unfinished secure operation gets no new calls, frees, or collapse. */
+	if (result == ZAP_UNFINISHED) {
+		return false;
+	}
+	bool stopped = zap_call("SHUTDOWN", 6, 1, 0, 0) == ZAP_OK;
+	printf("SWEET SCM: zap test shutdown=%s; allocation retained until reset\n", stopped ? "complete" : "failed");
+	sweet_log_sync();
+	return stopped;
+}
