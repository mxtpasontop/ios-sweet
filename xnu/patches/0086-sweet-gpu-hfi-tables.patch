+/*
+ * Read-only: the RPMh address and VLVL table (cmd-db aux data, one u16 per
+ * level, zero padded) of an ARC resource such as "gfx.lvl", for the GPU's
+ * GMU (sweet_gpu.c), like Linux cmd_db_read_addr + cmd_db_read_aux_data.
+ * *num counts levels as KGSL rpmh_arc_cmds does. Sends nothing to RPMh.
+ */
+#define RH_ARC          3u
+int sweet_rpmh_arc_levels(const char *res, uint16_t *vals, unsigned max,
+    unsigned *num, uint32_t *address);
+
+int
+sweet_rpmh_arc_levels(const char *res, uint16_t *vals, unsigned max,
+    unsigned *num, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0, len = 0;
+
+	if (!res || !vals || !num || !address || max == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			error = EINVAL;
+			goto out;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16), off = aux + rh_db16(e + 22);
+			len = rh_db16(e + 20);
+			if (slave != RH_ARC || (addr >> 16) != RH_ARC || (len & 1u) || !rh_range(off, len)) {
+				printf("SWEET RPMH: invalid ARC entry for %s\n", res);
+				error = EINVAL;
+				goto out;
+			}
+			for (unsigned k = 0; k < max; ++k) {
+				vals[k] = k < len / 2 ? rh_db16(off + 2 * k) : 0;
+			}
+			*address = addr;
+			++matches;
+		}
+	}
+	if (matches != 1 || len < 2) {
+		printf("SWEET RPMH: %s ARC lookup matches=%u len=%u; refusing\n", res, matches, len);
+		error = ENODEV;
+		goto out;
+	}
+	for (*num = 1; *num < MIN(len / 2, max); ++*num) {
+		if (vals[*num - 1] != 0 && vals[*num] == 0) {
+			break;
+		}
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
