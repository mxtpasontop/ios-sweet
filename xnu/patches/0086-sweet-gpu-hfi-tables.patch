+static bool
+arc_vote_tbl(const char *what, const uint16_t *pri, unsigned npri, const uint16_t *sec, unsigned nsec,
+    const unsigned *vlvl, unsigned n, uint32_t *votes)
+{
+	for (unsigned i = 0; i < n; i++) {
+		unsigned k, j;
+		for (k = 0; k < npri && pri[k] < vlvl[i]; k++) {
+		}
+		if (k == npri) {
+			printf("SWEET GPU: %s level %u: VLVL %u above the %u ARC levels\n", what, i, vlvl[i], npri);
+			return false;
+		}
+		for (j = 0; j < nsec; j++) {
+			if (sec[j] >= pri[k] || j + 1 == nsec) {
+				break;
+			}
+		}
+		votes[i] = ARC_VOTE(k, j == nsec ? 0 : j, pri[k]);
+	}
+	return true;
+}
