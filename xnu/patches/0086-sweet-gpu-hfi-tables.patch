+/*
+ * The rest of hfi_start for v1 firmware with the HFI_USE_REG quirk:
+ * DCVS table, bandwidth table, then H2F_MSG_TEST ("no more HFI until the
+ * next boot"). The bandwidth table has no RPMh commands yet: KGSL's comes
+ * from the msm_bus BCM votes, so the GMU votes no DDR/CNOC bandwidth
+ * (the CPU's votes keep DDR up).
+ */
+static bool
+gpu_hfi_tables(uint32_t *ack)
+{
+	uint32_t gx_khz[MAX_GX_LEVELS] = { 0 }, cx_khz[MAX_CX_LEVELS] = { 0 };
+	uint32_t m[BW_TBL_DW > PERF_TBL_DW ? BW_TBL_DW : PERF_TBL_DW];
+
+	if (!gpu_dcvs_votes(gx_khz, cx_khz)) {
+		return false;
+	}
+	bzero(m, sizeof(m));
+	m[0] = MSG_HDR(H2F_MSG_PERF_TBL, PERF_TBL_DW, 0);
+	m[1] = gx_levels;
+	m[2] = 2;
+	for (unsigned i = 0; i < gx_levels; i++) {
+		m[3 + 2 * i] = gx_votes[i];
+		m[4 + 2 * i] = gx_khz[i];
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		m[3 + 2 * MAX_GX_LEVELS + 2 * i] = cx_votes[i];
+		m[4 + 2 * MAX_GX_LEVELS + 2 * i] = cx_khz[i];
+	}
+	if (!hfi_cmd("H2F_MSG_PERF_TBL", m, PERF_TBL_DW, ack, 19)) {
+		return false;
+	}
+	bzero(m, sizeof(m));
+	m[0] = MSG_HDR(H2F_MSG_BW_VOTE_TBL, BW_TBL_DW, 0);
+	m[1] = 1;                               /* bw_level_num; cnoc/ddr cmds 0, wait masks 0 */
+	if (!hfi_cmd("H2F_MSG_BW_VOTE_TBL", m, BW_TBL_DW, ack, 19)) {
+		return false;
+	}
+	uint32_t test[2] = { MSG_HDR(H2F_MSG_TEST, 2, 0), 0 };
+	return hfi_cmd("H2F_MSG_TEST", test, 2, ack, 19);
+}
