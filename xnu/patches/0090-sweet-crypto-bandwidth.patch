+/*
+ * Downstream msm_bus path 125 -> 512, live sweet FDT. Units are bytes/s.
+ * Only this client is represented here. Shared DDR votes remain held for the
+ * boot: releasing an inherited apps-DRV vote requires global ownership tracking.
+ */
+#define RH_CRYPTO_COUNT 6u
+static bool rh_crypto_held;
+static uint64_t
+rh_bcm_div(uint64_t value, uint32_t divisor)
+{
+	return value && value < divisor ? 1 : value / divisor;
+}
+
+static int
+rh_crypto_plan(const struct sweet_rpmh_bcm info[RH_CRYPTO_COUNT],
+    struct rh_command commands[RH_CRYPTO_COUNT], uint32_t *wait)
+{
+	/* Order before sorting: CE0, SN11, SN0, SH0, MC0, ACV. */
+	static const uint16_t widths[] = { 8, 16, 16, 16, 4, 0 };
+	static const uint16_t ports[] = { 1, 1, 1, 2, 2, 0 };
+	const uint64_t average = 393600000ULL, peak = 3936000000ULL;
+	uint8_t domains[RH_CRYPTO_COUNT];
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		const struct sweet_rpmh_bcm *b = &info[i];
+		if (b->version != 0x1000 || b->reserved || !b->unit || b->vcd >= 16 ||
+		    (b->address >> 16) != RH_BCM || (b->address & 3u) ||
+		    (i < 5 && (!b->width || b->width > 64)) ||
+		    (i == 5 && (b->width != 0 || b->unit != 1))) {
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < i; ++j) {
+			if (info[j].address == b->address) {
+				return EINVAL;
+			}
+		}
+		uint64_t x = 0, y = 8; /* BCM ACV: apps bit, msm_bus_arb_rpmh.c. */
+		if (i < 5) {
+			x = rh_bcm_div(rh_bcm_div(average * b->width, widths[i] * ports[i]), b->unit);
+			y = rh_bcm_div(rh_bcm_div(peak * b->width, widths[i]), b->unit);
+		}
+		x = MIN(x, 0x3fffULL);
+		y = MIN(y, 0x3fffULL);
+		commands[i].address = b->address;
+		commands[i].data = (1u << 29) | ((uint32_t)x << 14) | (uint32_t)y;
+		domains[i] = b->vcd;
+	}
+	/* All commands for a VCD must precede that VCD's final commit. */
+	for (unsigned i = 1; i < RH_CRYPTO_COUNT; ++i) {
+		unsigned j = i;
+		while (j && domains[j] < domains[j - 1]) {
+			uint8_t domain = domains[j];
+			domains[j] = domains[j - 1]; domains[j - 1] = domain;
+			struct rh_command cmd = commands[j];
+			commands[j] = commands[j - 1]; commands[j - 1] = cmd;
+			j--;
+		}
+	}
+	*wait = 0;
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		if (i + 1 == RH_CRYPTO_COUNT || domains[i] != domains[i + 1]) {
+			commands[i].data |= 1u << 30;
+			*wait |= 1u << i;
+		}
+	}
+	return 0;
+}
+
+int
+sweet_rpmh_crypto_bw(void)
+{
+	static const char *const names[] = { "CE0", "SN11", "SN0", "SH0", "MC0", "ACV" };
+	struct sweet_rpmh_bcm info[RH_CRYPTO_COUNT];
+	struct rh_command commands[RH_CRYPTO_COUNT];
+	uint32_t wait;
+	/* Read/validate every descriptor before touching any TCS. */
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		int error = sweet_rpmh_bcm_info(names[i], &info[i]);
+		if (error) {
+			return error;
+		}
+	}
+	int error = rh_crypto_plan(info, commands, &wait);
+	if (error) {
+		return error;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		error = EIO;
+		goto out;
+	}
+	if (rh_crypto_held) {
+		goto out;
+	}
+	error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned i = 0; i < RH_CRYPTO_COUNT; ++i) {
+		printf("SWEET RPMH: crypto BCM[%u] addr=%#x data=%#x wait=%u\n",
+		    i, commands[i].address, commands[i].data, !!(wait & (1u << i)));
+	}
+	error = rh_send_commands(commands, RH_CRYPTO_COUNT, wait);
+	if (!error) {
+		rh_crypto_held = true;
+		printf("SWEET RPMH: crypto bandwidth held until reset\n");
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
