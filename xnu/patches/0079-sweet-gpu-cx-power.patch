+/* Poll until (reg & mask) == want; true on success. */
+static bool
+gpu_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i <= us; i++) {
+		if ((gpu_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
