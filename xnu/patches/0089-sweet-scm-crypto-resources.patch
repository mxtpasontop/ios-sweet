+/* Linux qcom_icc_bcm_init's cmd-db address + eight-byte bcm_db descriptor. */
+#define RH_BCM 5u
+static uint16_t
+rh_bcm_u16(uint32_t off)
+{
+	uint32_t lo = rh_read(rh_db, off & ~3u) >> (8u * (off & 3u));
+	uint32_t hi = rh_read(rh_db, (off + 1u) & ~3u) >> (8u * ((off + 1u) & 3u));
+	return (uint16_t)((lo & 0xffu) | ((hi & 0xffu) << 8));
+}
+
+int
+sweet_rpmh_bcm_info(const char *res, struct sweet_rpmh_bcm *info)
+{
+	uint32_t key[2] = { 0, 0 };
+	struct sweet_rpmh_bcm found = { 0 };
+	unsigned matches = 0, n = 0;
+	if (!res || !info) {
+		return EINVAL;
+	}
+	while (n < 8 && res[n]) {
+		key[n / 4] |= (uint32_t)(uint8_t)res[n] << (8u * (n % 4));
+		n++;
+	}
+	if (n == 0 || (n == 8 && res[n])) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (error) {
+		goto out;
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			error = EINVAL;
+			goto out;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t address = rh_read(rh_db, e + 16);
+			uint32_t off = aux + rh_db16(e + 22);
+			unsigned len = rh_db16(e + 20);
+			if (slave != RH_BCM || (address >> 16) != RH_BCM || (address & 3u) ||
+			    len < 8 || !rh_range(off, len)) {
+				error = EINVAL;
+				goto out;
+			}
+			/* Aux entries need not be word-aligned. Read via aligned DB words. */
+			found.address = address;
+			found.unit = (uint32_t)rh_bcm_u16(off) | ((uint32_t)rh_bcm_u16(off + 2) << 16);
+			found.width = rh_bcm_u16(off + 4);
+			found.vcd = rh_bcm_u16(off + 6) & 0xff;
+			found.reserved = rh_bcm_u16(off + 6) >> 8;
+			found.version = rh_db16(h + 8);
+			matches++;
+		}
+	}
+	if (matches != 1) {
+		error = ENODEV;
+	} else {
+		*info = found;
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
