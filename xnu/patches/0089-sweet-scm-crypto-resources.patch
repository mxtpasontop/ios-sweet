+/* Recovery live FDT: master 125 (crypto) -> slave 512 (DDR), deduplicated BCMs. */
+static void
+scm_crypto_resources(void)
+{
+	static const char *const names[] = { "CE0", "SN11", "SN0", "SH0", "MC0", "ACV" };
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+		struct sweet_rpmh_bcm b;
+		int error = sweet_rpmh_bcm_info(names[i], &b);
+		if (error) {
+			printf("SWEET SCM: BCM %s lookup failed errno=%d\n", names[i], error);
+			continue;
+		}
+		printf("SWEET SCM: BCM %s addr=%#x unit=%u width=%u vcd=%u reserved=%u version=%#x\n",
+		    names[i], b.address, b.unit, b.width, b.vcd, b.reserved, b.version);
+	}
+	/* GCC is always accessible; do not read the potentially gated CE itself. */
+	vm_offset_t gcc = ml_io_map(0x00100000u, 0x90000u);
+	if (gcc) {
+		static const uint32_t offsets[] = { 0x41004u, 0x41008u, 0x4100cu, 0x52004u };
+		static const char *const clocks[] = { "core", "axi", "ahb", "shared_vote" };
+		for (unsigned i = 0; i < sizeof(offsets) / sizeof(offsets[0]); ++i) {
+			uint32_t v = *(volatile uint32_t *)(gcc + offsets[i]);
+			__asm__ volatile("dmb oshld" ::: "memory");
+			printf("SWEET SCM: CE1 %s GCC+%#x = %#x\n", clocks[i], offsets[i], v);
+		}
+	} else {
+		printf("SWEET SCM: GCC mapping failed\n");
+	}
+	sweet_log_sync();
+}
