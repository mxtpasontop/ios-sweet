+#define TTBCR_GMU               ((2u << 12) | (0u << 10) | (0u << 8) | (0u << 14) | (1u << 23) | 32u)
+#define TTBCR2_GMU              (1u | (7u << 15) | (1u << 4))     /* PS 36 bit, SEP upstream, AS */
