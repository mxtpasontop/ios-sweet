+static vm_offset_t gmem;        /* kernel VA of the (non-cacheable) GMU memory block */
+static uint64_t gmem_pa;
+static uint32_t hfi_seq;
+
+static uint32_t gm_rd(uint32_t off) { return gpu_rd(gmem, off); }
+static void gm_wr(uint32_t off, uint32_t v) { gpu_wr(gmem, off, v); }
+
+static void
+gm_wr64(uint32_t off, uint64_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(gmem + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Map GMU VA va (4 KiB pages, 0x60000000-0x603fffff) to gmem + off. */
+static void
+gm_map(uint32_t va, uint32_t off, uint32_t size)
+{
+	for (uint32_t done = 0; done < size; done += 0x1000) {
+		uint32_t v = va + done;
+		uint32_t l3 = ((v >> 21) & 0x1ff) == ((GMU_VA_DUMMY >> 21) & 0x1ff) ? GMEM_L3A : GMEM_L3B;
+		gm_wr64(l3 + 8 * ((v >> 12) & 0x1ff), (gmem_pa + off + done) | PTE_PAGE_NC);
+	}
+}
+
+static bool
+gpu_gmem_alloc(void)
+{
+	vm_offset_t kva;
+
+	if (kmem_alloc_contig(kernel_map, &kva, GMEM_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: no contiguous GMU memory\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (!pn) {
+		return false;
+	}
+	gmem_pa = ptoa_64(pn);
+	for (unsigned i = 0; i < GMEM_SIZE / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	flush_dcache64((addr64_t)gmem_pa, GMEM_SIZE, TRUE);    /* pmap_sync_wimg did this too */
+	gmem = kva;
+	/* 32-bit VA, 4 KiB granule: walks start at level 1 (VA[31:30]). */
+	gm_wr64(GMEM_L1 + 8 * (GMU_VA_HFI >> 30), (gmem_pa + GMEM_L2) | PTE_TABLE);
+	gm_wr64(GMEM_L2 + 8 * ((GMU_VA_DUMMY >> 21) & 0x1ff), (gmem_pa + GMEM_L3A) | PTE_TABLE);
+	gm_wr64(GMEM_L2 + 8 * ((GMU_VA_DUMP >> 21) & 0x1ff), (gmem_pa + GMEM_L3B) | PTE_TABLE);
+	gm_map(GMU_VA_DUMMY, GMEM_DUMMY, 0x1000);
+	gm_map(GMU_VA_HFI, GMEM_HFI, GMEM_HFI_SIZE);
+	gm_map(GMU_VA_DUMP, GMEM_DUMP, GMEM_DUMP_SIZE);
+	gm_map(GMU_VA_LOG, GMEM_LOG, 0x1000);
+	printf("SWEET GPU: GMU memory at 0x%llx: dummy 0x%08x, HFI 0x%08x, dump 0x%08x, log 0x%08x\n",
+	    gmem_pa, GMU_VA_DUMMY, GMU_VA_HFI, GMU_VA_DUMP, GMU_VA_LOG);
+	return true;
+}
+
+static bool
+smmu_sync(vm_offset_t base, uint32_t sync, uint32_t status)
+{
+	gpu_wr(base, sync, 0);
+	if (!gpu_poll(base, status, 1, 0, 10000)) {
+		printf("SWEET GPU: SMMU TLB sync timed out (0x%x)\n", sync);
+		return false;
+	}
+	return true;
+}
