+/* Nothing services the GMU after the test: put it back into reset. */
+static void
+gpu_gmu_reset(void)
+{
+	gpu_wr(gmu, GMU_CM3_SYSRESET, 1);
+	delay(10);
+	gpu_gmu_state("reset again");
+}
